[Unit]
Description=CentralSSH hardened SSH gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/centralssh --listen 0.0.0.0:7788 --config /etc/centralssh/config.json --servers /etc/centralssh/servers.json --known-hosts /etc/centralssh/known_hosts --user-key-root /etc/centralssh/users --audit-log /var/log/centralssh/audit.jsonl
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/centralssh /var/log/centralssh

[Install]
WantedBy=multi-user.target
