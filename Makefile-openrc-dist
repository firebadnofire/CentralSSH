# Makefile for installing a CentralSSH Linux OpenRC release tarball

APP := centralssh
KEYSCAN_TOOL := cssh-keyscan

INSTALL_PREFIX ?= /usr/local
SBINDIR ?= $(INSTALL_PREFIX)/sbin
BINDIR ?= $(INSTALL_PREFIX)/bin
SYSCONFDIR ?= /etc/centralssh
LOCALSTATEDIR ?= /var
LOGDIR ?= $(LOCALSTATEDIR)/log/centralssh
OPENRC_INIT_DIR ?= /etc/init.d
INSTALL ?= install

APP_BIN := bin/$(APP)
KEYSCAN_BIN := bin/$(KEYSCAN_TOOL)
DEFAULT_CONF := examples/config.toml
SERVERS_CONF := examples/servers.toml
README_DOC := README.md
OP_GUIDE_DOC := op-guide.md
OPENRC_SERVICE := packaging/openrc/centralssh

.PHONY: install uninstall check-files

check-files:
	@test -x "$(APP_BIN)" || { echo "error: missing executable $(APP_BIN)"; exit 1; }
	@test -x "$(KEYSCAN_BIN)" || { echo "error: missing executable $(KEYSCAN_BIN)"; exit 1; }
	@test -f "$(DEFAULT_CONF)" || { echo "error: missing $(DEFAULT_CONF)"; exit 1; }
	@test -f "$(SERVERS_CONF)" || { echo "error: missing $(SERVERS_CONF)"; exit 1; }
	@test -f "$(README_DOC)" || { echo "error: missing $(README_DOC)"; exit 1; }
	@test -f "$(OP_GUIDE_DOC)" || { echo "error: missing $(OP_GUIDE_DOC)"; exit 1; }
	@test -f "$(OPENRC_SERVICE)" || { echo "error: missing $(OPENRC_SERVICE)"; exit 1; }

install: check-files
	$(INSTALL) -d "$(DESTDIR)$(SBINDIR)" "$(DESTDIR)$(BINDIR)"
	$(INSTALL) -m 0755 "$(APP_BIN)" "$(DESTDIR)$(SBINDIR)/$(APP)"
	$(INSTALL) -m 0755 "$(KEYSCAN_BIN)" "$(DESTDIR)$(BINDIR)/$(KEYSCAN_TOOL)"
	$(INSTALL) -d -m 0700 "$(DESTDIR)$(SYSCONFDIR)"
	@if [ ! -f "$(DESTDIR)$(SYSCONFDIR)/config.toml" ]; then \
		$(INSTALL) -m 0600 "$(DEFAULT_CONF)" "$(DESTDIR)$(SYSCONFDIR)/config.toml"; \
	fi
	@if [ ! -f "$(DESTDIR)$(SYSCONFDIR)/servers.toml" ]; then \
		$(INSTALL) -m 0600 "$(SERVERS_CONF)" "$(DESTDIR)$(SYSCONFDIR)/servers.toml"; \
	fi
	@if [ ! -f "$(DESTDIR)$(SYSCONFDIR)/known_hosts" ]; then \
		$(INSTALL) -m 0600 /dev/null "$(DESTDIR)$(SYSCONFDIR)/known_hosts"; \
	fi
	$(INSTALL) -d -m 0700 "$(DESTDIR)$(LOGDIR)"
	@if [ ! -f "$(DESTDIR)$(LOGDIR)/audit.jsonl" ]; then \
		$(INSTALL) -m 0600 /dev/null "$(DESTDIR)$(LOGDIR)/audit.jsonl"; \
	fi
	$(INSTALL) -d "$(DESTDIR)$(OPENRC_INIT_DIR)"
	$(INSTALL) -m 0755 "$(OPENRC_SERVICE)" "$(DESTDIR)$(OPENRC_INIT_DIR)/centralssh"

uninstall:
	rm -f "$(DESTDIR)$(SBINDIR)/$(APP)"
	rm -f "$(DESTDIR)$(BINDIR)/$(KEYSCAN_TOOL)"
	rm -f "$(DESTDIR)$(OPENRC_INIT_DIR)/centralssh"
